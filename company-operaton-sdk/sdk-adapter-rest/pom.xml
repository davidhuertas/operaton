<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.company.operaton.sdk</groupId>
    <artifactId>company-operaton-sdk-root</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sdk-adapter-rest</artifactId>
  <packaging>jar</packaging>

  <name>Company Operaton SDK - REST Adapter</name>
  <description>
    Pure Spring MVC controllers (no JAX-RS/Jersey/RestEasy runtime), generated from Operaton's
    published OpenAPI spec and bound to Operaton's own DTO classes. Proof-of-concept scope:
    the Task resource only (query tasks, complete task).
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.company.operaton.sdk</groupId>
        <artifactId>company-operaton-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Not transitively inherited from operaton-bpm-spring-boot-starter across the artifact
           boundary - re-import explicitly so plain Spring Boot artifact versions resolve. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${version.spring-boot}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Spec source: needed only at build time to unpack openapi.json. Never a runtime
         dependency of the adapter itself - excluded from the packaged jar's transitive
         graph by scope. -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine-rest-openapi</artifactId>
      <version>${operaton.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- DTOs reused directly: TaskDto, TaskQueryDto, TaskWithAttachmentAndCommentDto,
         CompleteTaskDto, VariableValueDto, ExceptionDto. -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine-rest-core</artifactId>
      <version>${operaton.version}</version>
    </dependency>

    <!-- Engine services (TaskService, ProcessEngine, ...) + Spring Boot autoconfiguration. -->
    <dependency>
      <groupId>org.operaton.bpm.springboot</groupId>
      <artifactId>operaton-bpm-spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>com.company.operaton.sdk</groupId>
      <artifactId>sdk-engine-config</artifactId>
    </dependency>

    <!-- Pure Spring MVC - no JAX-RS runtime. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Compile-time dependency of the openapi-generator "spring" output's @Operation/
         @ApiResponse/@Schema annotations (cannot be disabled - the spring generator always
         emits them at this version). Version matches what openapi-generator 7.23.0 itself
         resolves. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>2.2.52</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot 4 moved TestRestTemplate out of spring-boot-test into its own artifact,
         which in turn needs RestTemplateBuilder from spring-boot-restclient. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Step 1: unpack openapi.json out of the operaton-engine-rest-openapi jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-operaton-openapi-spec</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.operaton.bpm</groupId>
                  <artifactId>operaton-engine-rest-openapi</artifactId>
                  <version>${operaton.version}</version>
                  <includes>openapi.json</includes>
                  <outputDirectory>${project.build.directory}/operaton-openapi</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Step 2: filter the full spec down to just the Task tag (+ transitively referenced
           schemas) before generation. Generating against the FULL spec was tried first (the
           delegate pattern's default 501 fallback would make every non-Task endpoint a safe
           no-op) but hit several unrelated, pre-existing bugs in Operaton's own spec examples:
           Decision Definition, Decision Requirements Definition, Identity, and Process
           Definition all embed multi-line XML/example content that openapi-generator drops
           into Java string literals without re-escaping, breaking compilation. Filtering to
           Task avoids that whole class of bugs. Scaling to more resources later means adding
           their tag to this filter (or generating per-tag) once each is verified to generate
           cleanly - not something to do blindly against the full spec. Requires python3 on the
           build machine; see src/build/filter_openapi_spec.py. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>filter-openapi-spec-to-task-tag</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${project.basedir}/src/build/filter_openapi_spec.py</argument>
                <argument>${project.build.directory}/operaton-openapi/openapi.json</argument>
                <argument>${project.build.directory}/operaton-openapi/openapi-task-only.json</argument>
                <argument>Task</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Step 3: generate Spring MVC delegate interfaces from the filtered spec, bound to
           Operaton's existing DTO classes via importMappings/schemaMappings so no duplicate
           models are minted. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi.generator.version}</version>
        <executions>
          <execution>
            <id>generate-spring-delegates</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.build.directory}/operaton-openapi/openapi-task-only.json</inputSpec>
              <generatorName>spring</generatorName>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>com.company.operaton.sdk.rest.generated.api</apiPackage>
              <modelPackage>com.company.operaton.sdk.rest.generated.model</modelPackage>
              <invokerPackage>com.company.operaton.sdk.rest.generated</invokerPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <delegatePattern>true</delegatePattern>
                <useTags>true</useTags>
                <useSpringBoot3>true</useSpringBoot3>
                <dateLibrary>java8</dateLibrary>
              </configOptions>
              <schemaMappings>
                TaskQueryDto=org.operaton.bpm.engine.rest.dto.task.TaskQueryDto,TaskDto=org.operaton.bpm.engine.rest.dto.task.TaskDto,TaskWithAttachmentAndCommentDto=org.operaton.bpm.engine.rest.dto.task.TaskWithAttachmentAndCommentDto,CompleteTaskDto=org.operaton.bpm.engine.rest.dto.task.CompleteTaskDto,VariableValueDto=org.operaton.bpm.engine.rest.dto.VariableValueDto,ExceptionDto=org.operaton.bpm.engine.rest.dto.ExceptionDto
              </schemaMappings>
              <importMappings>
                TaskQueryDto=org.operaton.bpm.engine.rest.dto.task.TaskQueryDto,TaskDto=org.operaton.bpm.engine.rest.dto.task.TaskDto,TaskWithAttachmentAndCommentDto=org.operaton.bpm.engine.rest.dto.task.TaskWithAttachmentAndCommentDto,CompleteTaskDto=org.operaton.bpm.engine.rest.dto.task.CompleteTaskDto,VariableValueDto=org.operaton.bpm.engine.rest.dto.VariableValueDto,ExceptionDto=org.operaton.bpm.engine.rest.dto.ExceptionDto
              </importMappings>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>
